# 받은 키를 각 줄의 = 뒤에 붙여넣고 저장(Ctrl+S)하세요. 띄어쓰기나 따옴표 없이 그대로 붙이면 됩니다.
# 이 파일은 인터넷(GitHub)에 올라가지 않도록 막아 두었습니다.

# 1) 공공데이터포털 > 마이페이지 > 개발계정 > 일반 인증키 (Decoding)
DATA_GO_KR_KEY=

# 2) 네이버 개발자센터 > Application > 내 애플리케이션
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 3) 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키
KAKAO_REST_KEY=
KAKAO_JS_KEY=
