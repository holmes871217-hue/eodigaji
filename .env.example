# 받은 키를 각 줄의 = 뒤에 붙여넣고 저장(Ctrl+S)하세요. 띄어쓰기나 따옴표 없이 그대로 붙이면 됩니다.
# 이 파일은 인터넷(GitHub)에 올라가지 않도록 막아 두었습니다.

# 1) 공공데이터포털 > 마이페이지 > 개발계정 > 일반 인증키 (Decoding)
DATA_GO_KR_KEY=

# 2) 카카오 디벨로퍼스 > 내 앱 > [앱] > [플랫폼 키]
KAKAO_REST_KEY=
KAKAO_JS_KEY=

# 3) (선택) 네이버 클라우드 플랫폼 NAVER API HUB 의 API 키
#    2026년 6월부터 네이버 검색·데이터랩은 개발자센터가 아니라 여기서만 신청할 수 있습니다.
NAVER_API_KEY_ID=
NAVER_API_KEY=

# 4) KOPIS 공연예술통합전산망 OPEN API 인증키 (메일로 받음, 1년 유효, 3개월 미사용 시 취소)
KOPIS_KEY=

# 5) 서울 열린데이터광장(data.seoul.go.kr) > 인증키 신청 (서울 문화행사·서울 주차장)
SEOUL_API_KEY=
